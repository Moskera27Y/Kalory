# Copia este archivo como .env y cambia los secretos
PORT=3001
JWT_SECRET=pon-aqui-un-texto-largo-aleatorio
ADMIN_TOKEN=pon-aqui-tu-clave-de-admin
# Cliente Google de ESCRITORIO (app .exe, flujo loopback)
GOOGLE_CLIENT_ID=60146882018-1ad06p3sgqlo46ka8s2msm50r2m2durd.apps.googleusercontent.com
# Cliente Google tipo WEB (login en movil via navegador) + su secreto
GOOGLE_WEB_CLIENT_ID=pega-aqui-el-id-del-cliente-web
GOOGLE_WEB_CLIENT_SECRET=pega-aqui-el-secreto-del-cliente-web
# (compat) si no defines los WEB, se usa GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=
