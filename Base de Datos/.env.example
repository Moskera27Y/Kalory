# Copia este archivo como .env y cambia los secretos
PORT=3001
JWT_SECRET=pon-aqui-un-texto-largo-aleatorio
ADMIN_TOKEN=pon-aqui-tu-clave-de-admin
# Cliente Google de ESCRITORIO (app .exe, flujo loopback)
GOOGLE_CLIENT_ID=60146882018-1ad06p3sgqlo46ka8s2msm50r2m2durd.apps.googleusercontent.com
# Cliente Google tipo WEB (login en movil via navegador) + su secreto
GOOGLE_WEB_CLIENT_ID=pega-aqui-el-id-del-cliente-web
GOOGLE_WEB_CLIENT_SECRET=pega-aqui-el-secreto-del-cliente-web
# (compat) si no defines los WEB, se usa GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=
# DATOS (obligatorio): cadena de conexión PostgreSQL (Neon free es ideal).
# Crea un proyecto en https://neon.tech → copia la "Connection string".
# Debe incluir sslmode=require (Neon lo exige) — NO uses un DATA_FILE local:
# el disco de Render/Docker es efímero y la base se borraría en cada reinicio.
DATABASE_URL=postgresql://usuario:clave@ep-tu-host.us-east-1.aws.neon.tech/kalory?sslmode=require
# (local sin TLS) PGSSL=disable
# Lector de calorías (IA gratuita vía OpenRouter, solo móvil). Crea tu clave gratis en https://openrouter.ai
OPENROUTER_API_KEY=pega-aqui-tu-clave-de-openrouter
